# App
ENV=development
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=
APP_TIMEZONE=America/Los_Angeles

# Airtable personal access token. Scopes: data.records:read, data.records:write, schema.bases:read, schema.bases:write
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=

# Google sign in (Google Auth Platform > Clients > Web application). See the README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Leave blank: any Google account may try, and the Airtable Users table decides who gets in
ALLOWED_EMAIL_DOMAIN=
# Comma separated. Creates an Active Admin row for these emails if they have no Users row yet
BOOTSTRAP_ADMIN_EMAILS=avanthi.arun@gmail.com

# Let any signed in user switch between admin and staff views (development and demos only)
DEV_ALLOW_VIEW_SWITCH=false
# Local testing without Google: signs you straight in as this person from the Airtable Users table.
# Leave blank to use real Google sign in. The app refuses to start with this set outside localhost.
DEV_LOGIN_EMAIL=

# Email through the Gmail API. See "Set up email" in the README.
GMAIL_SENDER=avanthi.arun@gmail.com
# Optional, defaults to GOOGLE_CLIENT_ID
GMAIL_CLIENT_ID=
# Optional, defaults to GOOGLE_CLIENT_SECRET
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Set false once the test email works
REMINDERS_DRY_RUN=true

# Who runs the app. Shown on the Privacy and Terms pages and at the bottom of every email.
ORG_NAME=No More Under
# Where privacy questions, data deletion requests and "stop emailing me" replies go. Use an NMU inbox someone reads.
CONTACT_EMAIL=
# NMU's mailing address on one line, for example "123 Main St, Seattle, WA 98101"
ORG_ADDRESS=
